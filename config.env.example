# Copy to config.env, fill in, then: sudo ./setup.sh
# setup.sh installs this to /etc/homeserver/config.env (root-only, chmod 600).

# ---------- Wi-Fi ----------
WIFI_SSID="Shivalaya"
WIFI_PASSWORD="changeme"
WIFI_IFACE=""                 # blank = auto-detect first wifi device
WIFI_KEY_MGMT="wpa-psk"       # wpa-psk (WPA2) or sae (WPA3-only routers)
WIFI_HIDDEN="no"              # yes if SSID is hidden
WIFI_CON_NAME="home-wifi"     # NetworkManager profile name

# Watchdog runs every 2 min. After this many consecutive failed checks
# (gateway unreachable) the laptop reboots. 0 = never reboot.
WATCHDOG_REBOOT_AFTER=10

# ---------- Tailscale ----------
TS_HOSTNAME="homeserver"
TS_AUTHKEY=""                 # optional; blank = prints a login URL
TS_SSH="yes"                  # Tailscale SSH: second way in if sshd breaks
TS_ADVERTISE_LAN="yes"        # subnet router -> reach router admin page remotely
TS_EXIT_NODE="no"             # yes = route all your traffic via home

# ---------- Porkbun DDNS ----------
PORKBUN_API_KEY="pk1_..."
PORKBUN_SECRET_KEY="sk1_..."
DDNS_DOMAIN="4rc.in"
# Space-separated. "@" = root (4rc.in), "*" = wildcard, or names like "home".
DDNS_RECORDS="@"
DDNS_TTL=600                  # Porkbun minimum is 600

# ---------- SSH ----------
SSH_PASSWORD_AUTH="yes"       # set "no" once your key works
SSH_AUTHORIZED_KEY=""         # e.g. "ssh-ed25519 AAAA... arc@fedora"

# ---------- Laptop-as-server ----------
BATTERY_LIMIT=80              # max charge %, saves battery when always plugged. 0 = skip
